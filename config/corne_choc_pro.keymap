#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // ----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |       |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |       | ENT | RSE  | ALT |
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T  &trans &trans  &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
                &kp LCTRL &kp A &kp S &kp D &kp F &kp G  &trans &trans  &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B                 &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                                      &kp LGUI &mo 1 &kp SPACE          &kp RET &mo 2 &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        lower_layer {
            display-name = "NUMBER";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |   |   |  6    |  7   |  8  |  9    |  0  | BSPC |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   |   |   | LFT   | DWN  |  UP | RGT   |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|       | PG_UP | HOME | END | PG_DN |     |      |
            //                    | GUI |     | SPC   |       | GUI   |      | SPC |
            bindings = <
                &kp TAB   &kp N1       &kp N2          &kp N3       &kp N4       &kp N5        &trans &trans  &kp N6    &kp N7   &kp N8  &kp N9     &kp N0 &kp BSPC
                &kp LCTRL &bt BT_SEL 0 &bt BT_SEL 1    &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4  &trans &trans  &kp LEFT  &kp DOWN &kp UP  &kp RIGHT  &trans &trans
                &kp LSHFT &bt BT_CLR   &rgb_ug RGB_TOG &sys_reset   &bootloader  &studio_unlock               &kp PG_UP &kp HOME &kp END &kp  PG_DN &trans &trans
                                                       &kp LGUI     &trans       &kp SPACE                    &kp LGUI  &trans   &kp SPACE
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |  1  |  2  |  3  |  4  |  5  |   |   |  -  |  =  |  \  |  [  |  ]  |  `   |
            // | SHFT |  6  |  7  |  8  |  9  |  0  |       |  _  |  +  | "|" |  {  |  }  |  ~   |
            //                    | GUI |     | SPC |       | ENT |     | ALT |
            bindings = <
                &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &trans &trans &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL &kp N1   &kp N2 &kp N3   &kp N4   &kp N5    &trans &trans &kp MINUS &kp EQUAL &kp BSLH &kp LBKT &kp RBKT &kp GRAVE
                &kp LSHFT &kp N6   &kp N7 &kp N8   &kp N9   &kp N0                  &kp UNDER &kp PLUS  &kp PIPE &kp LBRC &kp RBRC &kp TILDE
                                          &kp LGUI &trans   &kp SPACE               &kp RET   &trans    &kp RALT
            >;
        };
    };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    behaviors {
        HML: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_L";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced"; // <--- This is the magic ingredient
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <7 8 12 13 21 22 23 24 25 26 27 34 35 36 37 38 39 43 9 10 11 44 45>;
            hold-trigger-on-release;
        };

        HMR: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 40 41 42>;
            hold-trigger-on-release;
        };

        CommaTapDance: CommaTapDance {
            compatible = "zmk,behavior-tap-dance";
            label = "COMMATAPDANCE";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;
        };

        PeriodTapDance: PeriodTapDance {
            compatible = "zmk,behavior-tap-dance";
            label = "PERIODTAPDANCE";
            #binding-cells = <0>;
            bindings = <&kp PERIOD>, <&kp PERIOD>;
        };

        CommaSemi: CommaSemi {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMASEMI";
            bindings = <&kp COMMA>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        PeriodColon: PeriodColon {
            compatible = "zmk,behavior-mod-morph";
            label = "PERIODCOLON";
            bindings = <&kp PERIOD>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        HMShifL: HMShifL {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSHIFL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 34 35 36 37 38 39 43 44 45>;
        };

        HMShiftR: HMShiftR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSHIFTR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 40 41 42>;
        };

        QuesSLH: QuesSLH {
            compatible = "zmk,behavior-tap-dance";
            label = "QUESSLH";
            #binding-cells = <0>;
            bindings = <&kp QMARK>, <&kp BACKSLASH>;
        };
    };

    combos {
        compatible = "zmk,combos";

        exclCombo {
            bindings = <&kp EXCL>;
            key-positions = <15 1>;
            layers = <0>;
        };

        AtCombo {
            bindings = <&kp AT>;
            key-positions = <16 2>;
            layers = <0>;
        };

        HashCombo {
            bindings = <&kp HASH>;
            key-positions = <17 3>;
            layers = <0>;
        };

        DollCombo {
            bindings = <&kp DOLLAR>;
            key-positions = <18 4>;
            layers = <0>;
        };

        PercCombo {
            bindings = <&kp PERCENT>;
            key-positions = <19 5>;
            layers = <0>;
        };

        CaretCombo {
            bindings = <&kp CARET>;
            key-positions = <22 8>;
            layers = <0>;
        };

        AmpsCombo {
            bindings = <&kp AMPERSAND>;
            key-positions = <23 9>;
            layers = <0>;
        };

        AsterCombo {
            bindings = <&kp ASTRK>;
            key-positions = <24 10>;
            layers = <0>;
        };

        LpareCombo {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <25 11>;
            layers = <0>;
        };

        RpareCombo {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <26 12>;
            layers = <0>;
        };

        LbrcCombo {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <37 25>;
            layers = <0>;
        };

        RbrcCombo {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <38 26>;
            layers = <0>;
        };

        UnderCombo {
            bindings = <&kp UNDER>;
            key-positions = <34 22>;
            layers = <0>;
        };

        MinusCombo {
            bindings = <&kp MINUS>;
            key-positions = <35 23>;
            layers = <0>;
        };

        PlusCombo {
            bindings = <&kp PLUS>;
            key-positions = <36 24>;
            layers = <0>;
        };

        PipeCombo {
            bindings = <&kp PIPE>;
            key-positions = <33 19>;
            layers = <0>;
        };

        EqualCombo {
            bindings = <&kp EQUAL>;
            key-positions = <32 18>;
            layers = <0>;
        };

        TildeCombo {
            bindings = <&kp TILDE>;
            key-positions = <31 17>;
            layers = <0>;
        };

        GraveCombo {
            bindings = <&kp GRAVE>;
            key-positions = <30 16>;
            layers = <0>;
        };

        CapsWord {
            bindings = <&caps_word>;
            key-positions = <29 15>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // LAYER 0: BASE (COLEMAK-DH)
        /*
               Pinky      Ring     Middle    Index     Inner             Inner      Index     Middle    Ring     Pinky
            ┌─────────┬─────────┬─────────┬─────────┬─────────┐       ┌─────────┬─────────┬─────────┬─────────┬─────────┐
        Top |    Q    |    W    |    F    |    P    |    B    |       |    J    |    L    |    U    |    Y    |    '    |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├─────────┼─────────┼─────────┼─────────┼─────────┤
        Home|    A    |    R    |    S    |    T    |    G    |       |    M    |    N    |    E    |    I    |    O    |
            |  (LALT) | (LCTRL) |  (LGUI) | (LSHFT) |         |       |         | (RSHFT) |  (RGUI) | (RCTRL) |  (RALT) |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├─────────┼─────────┼─────────┼─────────┼─────────┤
        Bot |    Z    |    X    |    C    |    D    |    V    |       |    K    |    H    |    ,    |    .    |    /    |
            └─────────┴─────────┴─────────┴─────────┴─────────┘       └─────────┴─────────┴─────────┴─────────┴─────────┘
                        (X)    ┌─────────┬─────────┬─────────┐       ┌─────────┬─────────┬─────────┐   (X)
                                |   ESC   |  SPACE  |   TAB   |       |   RET   |   BSPC  |   DEL   |
                                | (MEDIA) |  (NAV)  | (MOUSE) |       |  (SYM)  |  (NUM)  |  (FUN)  |
                                └─────────┴─────────┴─────────┘       └─────────┴─────────┴─────────┘
        */

        default_layout {
            display-name = "BASE";
            bindings = <
&kp TAB           &kp Q        &kp W         &kp F        &kp P         &kp B      &trans  &trans  &kp J      &kp L         &kp U           &kp Y            &kp SQT      &kp RIGHT_ALT
&kp LEFT_CONTROL  &HML LALT A  &HML LCTRL R  &HML LGUI S  &HML LSHFT T  &kp G      &trans  &trans  &kp M      &HMR RSHFT N  &HMR RGUI E     &HMR RCTRL I     &HMR RALT O  &kp RIGHT_GUI
&kp LEFT_SHIFT    &kp Z        &kp X         &kp C        &kp D         &kp V                      &kp K      &kp H         &CommaTapDance  &PeriodTapDance  &QuesSLH     &kp RIGHT_SHIFT
                                             &lt 4 ESC    &lt 1 SPACE   &lt 2 TAB                  &lt 3 RET  &lt 5 BSPC    &lt 6 DEL
            >;
        };

        // LAYER 1: NAV (Left Thumb Middle)
        /*
            ┌───────────┬────────────┬────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |     X     |      X     |      X     |      X     |      X     |   |    AGAIN   |    PASTE   |    COPY    |     CUT    |    UNDO    |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|     X     |    LALT    |    LCTRL   |    LGUI    |    LSHFT   |   |    CAPS    |    LEFT    |    DOWN    |     UP     |    RIGHT   |
            |           |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |   |            |            |            |            |            |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |     X     |      X     |      X     |      X     |      X     |   |     INS    |    HOME    |    PG_DN   |    PG_UP   |     END    |
            └───────────┴────────────┴────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┴────────────┴────────────┘
                                    ┌────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┐
                                    |      X     |   (HOLD)   |      X     |   |     RET    |    BSPC    |     DEL    |
                                    |            |     NAV    |            |   |            |            |            |
                                    └────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┘
        */

        nav_layer {
            display-name = "NAV";
            bindings = <
&trans  &trans    &trans     &trans    &trans     &trans  &trans  &trans  &kp K_REDO        &kp K_PASTE  &kp K_COPY  &kp K_CUT  &kp K_UNDO  &trans
&trans  &kp LALT  &kp LCTRL  &kp LGUI  &kp LSHFT  &trans  &trans  &trans  &kp LG(UP_ARROW)  &kp LEFT     &kp DOWN    &kp UP     &kp RIGHT   &trans
&trans  &trans    &trans     &trans    &trans     &trans                  &kp LG(DOWN)      &kp HOME     &kp PG_DN   &kp PG_UP  &kp END     &trans
                             &trans    &trans     &trans                  &kp RET           &kp BSPC     &kp DEL
            >;
        };

        // LAYER 2: MOUSE (Left Thumb Inner) - Placeholder for Mouse Keys
        /*
            ┌───────────┬────────────┬────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |     X     |      X     |      X     |      X     |      X     |   |    AGAIN   |    PASTE   |    COPY    |     CUT    |    UNDO    |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|     X     |    LALT    |    LCTRL   |    LGUI    |    LSHFT   |   |      -     |   MS LEFT  |   MS DOWN  |    MS UP   |  MS RIGHT  |
            |           |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |   |            |            |            |            |            |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |     X     |      X     |      X     |      X     |      X     |   |      -     |   SCRL LF  |   SCRL DN  |   SCRL UP  |   SCRL RT  |
            └───────────┴────────────┴────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┴────────────┴────────────┘
                                    ┌────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┐
                                    |      X     |      X     |   (HOLD)   |   |   R-CLICK  |   L-CLICK  |   M-CLICK  |
                                    |            |            |   MOUSE    |   |            |            |            |
                                    └────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┘
        */

        mouse_layer {
            display-name = "MOU";
            bindings = <
&trans  &trans    &trans     &trans    &trans     &trans  &trans  &trans  &kp GLOBE           &kp LS(LC(TAB))  &kp LG(LEFT)    &kp LG(RIGHT)  &kp LC(TAB)      &trans
&trans  &kp LALT  &kp LCTRL  &kp LGUI  &kp LSHFT  &trans  &trans  &trans  &kp LC(LEFT_ARROW)  &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_UP   &mmv MOVE_RIGHT  &trans
&trans  &trans    &trans     &trans    &trans     &trans                  &kp LC(RIGHT)       &msc SCRL_LEFT   &msc SCRL_DOWN  &msc SCRL_UP   &msc SCRL_RIGHT  &trans
                             &trans    &trans     &trans                  &mkp RCLK           &mkp LCLK        &mkp MCLK
            >;
        };

        // LAYER 3: SYM (Right Thumb Inner)
        /*
            ┌─────────┬─────────┬─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |    {    |    &    |    *    |    (    |    }    |       |      X     |      X     |      X     |      X     |      X     |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|    :    |    $    |    %    |    ^    |    +    |       |      X     |    RSHFT   |    RGUI    |    RCTRL   |    RALT    |
            |         |         |         |         |         |       |            |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |    ~    |    !    |    @    |    #    |    |    |       |      X     |      X     |      X     |      X     |      X     |
            └─────────┴─────────┴─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┴────────────┴────────────┘
                                ┌─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┐
                                |    (    |    )    |    _    |       |   (HOLD)   |      X     |      X     |
                                |         |         |         |       |     SYM    |            |            |
                                └─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┘
        */

        sym_layer {
            display-name = "SYM";
            bindings = <
&trans  &kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR   &kp RBRC   &trans  &trans  &trans  &trans     &trans    &trans     &trans    &trans
&trans  &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS   &trans  &trans  &trans  &kp RSHFT  &kp RGUI  &kp RCTRL  &kp RALT  &trans
&trans  &kp TILDE  &kp EXCL  &kp AT     &kp HASH   &kp PIPE                   &trans  &trans     &trans    &trans     &trans    &trans
                             &kp LPAR   &kp RPAR   &kp UNDER                  &trans  &trans     &trans
            >;
        };

        // LAYER 4: MEDIA (Left Thumb Outer)
        /*
            ┌───────────┬────────────┬────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |     X     |      X     |      X     |      X     |      X     |   |      X     |     BT 1   |     BT 2   |     BT 3   |      X     |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|     X     |    LALT    |    LCTRL   |    LGUI    |    LSHFT   |   |      X     |    PREV    |   VOL DN   |   VOL UP   |    NEXT    |
            |           |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |   |            |            |            |            |            |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |     X     |      X     |      X     |      X     |      X     |   |    BT CLR  |   SYS RST  |   BOOTLDR  |      X     |   STUDIO   |
            └───────────┴────────────┴────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┴────────────┴────────────┘
                                    ┌────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┐
                                    |   (HOLD)   |      X     |      X     |   |    STOP    |    PLAY    |    MUTE    |
                                    |    MEDIA   |            |            |   |            |            |            |
                                    └────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┘
        */

        media_layer {
            display-name = "MED";
            bindings = <
&trans  &trans    &trans     &trans    &trans     &trans  &trans  &trans  &bt BT_CLR   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans          &trans
&trans  &kp LALT  &kp LCTRL  &kp LGUI  &kp LSHFT  &trans  &trans  &trans  &bootloader  &kp C_PREV    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT      &trans
&trans  &trans    &trans     &trans    &trans     &trans                  &sys_reset   &trans        &trans        &trans        &studio_unlock  &trans
                             &trans    &trans     &trans                  &kp C_STOP   &kp C_PP      &kp C_MUTE
            >;
        };

        // LAYER 5: NUM (Right Thumb Middle)
        /*
            ┌─────────┬─────────┬─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |    [    |    7    |    8    |    9    |    ]    |       |      X     |      X     |      X     |      X     |      X     |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|    ;    |    4    |    5    |    6    |    =    |       |      X     |    RSHFT   |    RGUI    |    RCTRL   |    RALT    |
            |         |         |         |         |         |       |            |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |    `    |    1    |    2    |    3    |    \    |       |      X     |      X     |      X     |      X     |      X     |
            └─────────┴─────────┴─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┴────────────┴────────────┘
                                ┌─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┐
                                |    .    |    0    |    -    |       |      X     |   (HOLD)   |      X     |
                                |         |         |         |       |            |     NUM    |            |
                                └─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┘
        */

        num_layer {
            display-name = "NUM";
            bindings = <
&trans  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT   &trans  &trans  &trans  &trans     &trans    &trans     &trans    &trans
&trans  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL  &trans  &trans  &trans  &kp RSHFT  &kp RGUI  &kp RCTRL  &kp RALT  &trans
&trans  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH                   &trans  &trans     &trans    &trans     &trans    &trans
                           &kp DOT  &kp N0  &kp MINUS                  &trans  &trans     &trans
            >;
        };

        // LAYER 6: FUN (Right Thumb Outer)
        /*
            ┌─────────┬─────────┬─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |  PSCRN  |    F9   |    F8   |    F7   |   F12   |       |      X     |      X     |      X     |      X     |      X     |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|  SLCK   |    F6   |    F5   |    F4   |   F11   |       |      X     |    RSHFT   |    RGUI    |    RCTRL   |    RALT    |
            |         |         |         |         |         |       |            |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |  PAUSE  |    F3   |    F2   |    F1   |   F10   |       |      X     |      X     |      X     |      X     |      X     |
            └─────────┴─────────┴─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┴────────────┴────────────┘
                                ┌─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┐
                                |   APP   |  SPACE  |   TAB   |       |      X     |      X     |   (HOLD)   |
                                |         |         |         |       |            |            |     FUN    |
                                └─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┘
        */

        fun_layer {
            display-name = "FN";
            bindings = <
&trans  &kp F12  &kp F7  &kp F8     &kp F9     &kp PSCRN    &trans  &trans  &trans  &trans     &trans    &trans     &trans    &trans
&trans  &kp F11  &kp F4  &kp F5     &kp F6     &kp SLCK     &trans  &trans  &trans  &kp RSHFT  &kp RGUI  &kp RCTRL  &kp RALT  &trans
&trans  &kp F10  &kp F1  &kp F2     &kp F3     &kp C_PAUSE                  &trans  &trans     &trans    &trans     &trans    &trans
                         &kp K_APP  &kp SPACE  &kp TAB                      &trans  &trans     &trans
            >;
        };
    };
};
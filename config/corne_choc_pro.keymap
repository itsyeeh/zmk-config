#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    behaviors {
        HML: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_L";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced"; // <--- This is the magic ingredient
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <7 8 12 13 21 22 23 24 25 26 27 34 35 36 37 38 39 43 9 10 11 44 45>;
            hold-trigger-on-release;
        };

        HMR: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 40 41 42>;
            hold-trigger-on-release;
        };

        HMShifL: HMShifL {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSHIFL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 34 35 36 37 38 39 43 44 45>;
        };

        HMShiftR: HMShiftR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSHIFTR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 40 41 42>;
        };
    };

    combos {
        compatible = "zmk,combos";

        exclCombo {
            bindings = <&kp EXCL>;
            key-positions = <15 1>;
            layers = <0>;
        };

        AtCombo {
            bindings = <&kp AT>;
            key-positions = <16 2>;
            layers = <0>;
        };

        HashCombo {
            bindings = <&kp HASH>;
            key-positions = <17 3>;
            layers = <0>;
        };

        DollCombo {
            bindings = <&kp DOLLAR>;
            key-positions = <18 4>;
            layers = <0>;
        };

        PercCombo {
            bindings = <&kp PERCENT>;
            key-positions = <19 5>;
            layers = <0>;
        };

        CaretCombo {
            bindings = <&kp CARET>;
            key-positions = <22 8>;
            layers = <0>;
        };

        AmpsCombo {
            bindings = <&kp AMPERSAND>;
            key-positions = <23 9>;
            layers = <0>;
        };

        AsterCombo {
            bindings = <&kp ASTRK>;
            key-positions = <24 10>;
            layers = <0>;
        };

        LpareCombo {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <25 11>;
            layers = <0>;
        };

        RpareCombo {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <26 12>;
            layers = <0>;
        };

        LbrcCombo {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <37 25>;
            layers = <0>;
        };

        RbrcCombo {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <38 26>;
            layers = <0>;
        };

        PlusCombo {
            bindings = <&kp PLUS>;
            key-positions = <34 22>;
            layers = <0>;
        };

        LBraCombo {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <35 23>;
            layers = <0>;
        };

        RBraCombo {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <36 24>;
            layers = <0>;
        };

        MinusCombo {
            bindings = <&kp MINUS>;
            key-positions = <33 19>;
            layers = <0>;
        };

        EqualCombo {
            bindings = <&kp EQUAL>;
            key-positions = <32 18>;
            layers = <0>;
        };

        UnderCombo {
            bindings = <&kp UNDER>;
            key-positions = <31 17>;
            layers = <0>;
        };

        BFslCombo {
            bindings = <&kp BACKSLASH>;
            key-positions = <30 16>;
            layers = <0>;
        };

        PipeCombo {
            bindings = <&kp PIPE>;
            key-positions = <29 15>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // LAYER 0: BASE (COLEMAK-DH)
        /*
               Pinky      Ring     Middle    Index     Inner             Inner      Index     Middle    Ring     Pinky
            ┌─────────┬─────────┬─────────┬─────────┬─────────┐       ┌─────────┬─────────┬─────────┬─────────┬─────────┐
        Top |    Q    |    W    |    F    |    P    |    B    |       |    J    |    L    |    U    |    Y    |    '    |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├─────────┼─────────┼─────────┼─────────┼─────────┤
        Home|    A    |    R    |    S    |    T    |    G    |       |    M    |    N    |    E    |    I    |    O    |
            |  (LALT) | (LCTRL) |  (LGUI) | (LSHFT) |         |       |         | (RSHFT) |  (RGUI) | (RCTRL) |  (RALT) |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├─────────┼─────────┼─────────┼─────────┼─────────┤
        Bot |    Z    |    X    |    C    |    D    |    V    |       |    K    |    H    |    ,    |    .    |    /    |
            └─────────┴─────────┴─────────┴─────────┴─────────┘       └─────────┴─────────┴─────────┴─────────┴─────────┘
                        (X)    ┌─────────┬─────────┬─────────┐       ┌─────────┬─────────┬─────────┐   (X)
                                |   ESC   |  SPACE  |   TAB   |       |   RET   |   BSPC  |   DEL   |
                                | (MEDIA) |  (NAV)  | (MOUSE) |       |  (SYM)  |  (NUM)  |  (FUN)  |
                                └─────────┴─────────┴─────────┘       └─────────┴─────────┴─────────┘
        */

        default_layout {
            display-name = "BASE";
            bindings = <
&kp TAB           &kp Q        &kp W         &kp E         &kp R         &kp T    &trans  &trans  &kp Y    &kp U         &kp I        &kp O         &kp P           &kp GRAVE
&kp LEFT_CONTROL  &HML LALT A  &HML LCTRL S  &HML LGUI D   &HML LSHFT F  &kp G    &trans  &trans  &kp H    &HMR RSHFT J  &HMR RGUI K  &HMR RCTRL L  &HMR RALT SEMI  &kp APOSTROPHE
&kp LEFT_SHIFT    &kp Z        &kp X         &kp C         &kp V         &kp B                    &kp N    &kp M         &kp COMMA    &kp PERIOD    &kp FSLH        &kp RIGHT_SHIFT
                                             &kp LEFT_GUI  &lt 1 SPACE   &kp ESC                  &kp RET  &lt 2 BSPC    &lt 3 DEL
            >;
        };

        // LAYER 1: NAV (Left Thumb Middle)
        /*
            ┌───────────┬────────────┬────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |     X     |      X     |      X     |      X     |      X     |   |    AGAIN   |    PASTE   |    COPY    |     CUT    |    UNDO    |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|     X     |    LALT    |    LCTRL   |    LGUI    |    LSHFT   |   |    CAPS    |    LEFT    |    DOWN    |     UP     |    RIGHT   |
            |           |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |   |            |            |            |            |            |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |     X     |      X     |      X     |      X     |      X     |   |     INS    |    HOME    |    PG_DN   |    PG_UP   |     END    |
            └───────────┴────────────┴────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┴────────────┴────────────┘
                                    ┌────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┐
                                    |      X     |   (HOLD)   |      X     |   |     RET    |    BSPC    |     DEL    |
                                    |            |     NAV    |            |   |            |            |            |
                                    └────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┘
        */

        nav_layer {
            display-name = "NAV";
            bindings = <
&trans  &trans    &kp LG(X)  &kp LG(C)  &kp LG(V)  &trans  &trans  &trans  &kp RC(TAB)   &kp LG(V)  &kp LG(C)  &kp LG(X)  &kp RC(RS(TAB))  &trans
&trans  &kp LALT  &kp LCTRL  &kp LGUI   &kp LSHFT  &trans  &trans  &trans  &kp LG(UP)    &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT        &trans
&trans  &trans    &trans     &trans     &trans     &trans                  &kp LG(DOWN)  &kp HOME   &kp PG_DN  &kp PG_UP  &kp END          &trans
                             &trans     &trans     &trans                  &kp RET       &kp BSPC   &kp DEL
            >;
        };

        // LAYER 2: MOUSE (Left Thumb Inner) - Placeholder for Mouse Keys
        /*
            ┌───────────┬────────────┬────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |     X     |      X     |      X     |      X     |      X     |   |    AGAIN   |    PASTE   |    COPY    |     CUT    |    UNDO    |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|     X     |    LALT    |    LCTRL   |    LGUI    |    LSHFT   |   |      -     |   MS LEFT  |   MS DOWN  |    MS UP   |  MS RIGHT  |
            |           |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |   |            |            |            |            |            |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |     X     |      X     |      X     |      X     |      X     |   |      -     |   SCRL LF  |   SCRL DN  |   SCRL UP  |   SCRL RT  |
            └───────────┴────────────┴────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┴────────────┴────────────┘
                                    ┌────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┐
                                    |      X     |      X     |   (HOLD)   |   |   R-CLICK  |   L-CLICK  |   M-CLICK  |
                                    |            |            |   MOUSE    |   |            |            |            |
                                    └────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┘
        */
        // LAYER 3: SYM (Right Thumb Inner)
        /*
            ┌─────────┬─────────┬─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |    {    |    &    |    *    |    (    |    }    |       |      X     |      X     |      X     |      X     |      X     |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|    :    |    $    |    %    |    ^    |    +    |       |      X     |    RSHFT   |    RGUI    |    RCTRL   |    RALT    |
            |         |         |         |         |         |       |            |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |    ~    |    !    |    @    |    #    |    |    |       |      X     |      X     |      X     |      X     |      X     |
            └─────────┴─────────┴─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┴────────────┴────────────┘
                                ┌─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┐
                                |    (    |    )    |    _    |       |   (HOLD)   |      X     |      X     |
                                |         |         |         |       |     SYM    |            |            |
                                └─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┘
        */
        // LAYER 4: MEDIA (Left Thumb Outer)
        /*
            ┌───────────┬────────────┬────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |     X     |      X     |      X     |      X     |      X     |   |      X     |     BT 1   |     BT 2   |     BT 3   |      X     |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|     X     |    LALT    |    LCTRL   |    LGUI    |    LSHFT   |   |      X     |    PREV    |   VOL DN   |   VOL UP   |    NEXT    |
            |           |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |   |            |            |            |            |            |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |     X     |      X     |      X     |      X     |      X     |   |    BT CLR  |   SYS RST  |   BOOTLDR  |      X     |   STUDIO   |
            └───────────┴────────────┴────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┴────────────┴────────────┘
                                    ┌────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┐
                                    |   (HOLD)   |      X     |      X     |   |    STOP    |    PLAY    |    MUTE    |
                                    |    MEDIA   |            |            |   |            |            |            |
                                    └────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┘
        */
        // LAYER 5: NUM (Right Thumb Middle)
        /*
            ┌─────────┬─────────┬─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |    [    |    7    |    8    |    9    |    ]    |       |      X     |      X     |      X     |      X     |      X     |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|    ;    |    4    |    5    |    6    |    =    |       |      X     |    RSHFT   |    RGUI    |    RCTRL   |    RALT    |
            |         |         |         |         |         |       |            |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |    `    |    1    |    2    |    3    |    \    |       |      X     |      X     |      X     |      X     |      X     |
            └─────────┴─────────┴─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┴────────────┴────────────┘
                                ┌─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┐
                                |    .    |    0    |    -    |       |      X     |   (HOLD)   |      X     |
                                |         |         |         |       |            |     NUM    |            |
                                └─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┘
        */

        num_layer {
            display-name = "NUM";
            bindings = <
&trans  &kp EXCLAMATION  &kp AT    &kp HASH   &kp DOLLAR  &kp PERCENT  &trans  &trans  &kp CARET  &kp AMPS        &kp STAR         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp N1           &kp N2    &kp N3     &kp N4      &kp N5       &trans  &trans  &kp N6     &kp N7          &kp N8           &kp N9                &kp N0                 &trans
&trans  &kp PIPE         &kp BSLH  &kp UNDER  &kp EQUAL   &kp MINUS                    &kp PLUS   &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans
                                   &trans     &trans      &trans                       &trans     &trans          &trans
            >;
        };

        // LAYER 6: FUN (Right Thumb Outer)
        /*
            ┌─────────┬─────────┬─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |  PSCRN  |    F9   |    F8   |    F7   |   F12   |       |      X     |      X     |      X     |      X     |      X     |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|  SLCK   |    F6   |    F5   |    F4   |   F11   |       |      X     |    RSHFT   |    RGUI    |    RCTRL   |    RALT    |
            |         |         |         |         |         |       |            |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |  PAUSE  |    F3   |    F2   |    F1   |   F10   |       |      X     |      X     |      X     |      X     |      X     |
            └─────────┴─────────┴─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┴────────────┴────────────┘
                                ┌─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┐
                                |   APP   |  SPACE  |   TAB   |       |      X     |      X     |   (HOLD)   |
                                |         |         |         |       |            |            |     FUN    |
                                └─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┘
        */

        fun_layer {
            display-name = "FN";
            bindings = <
&trans  &kp F12  &kp F7  &kp F8     &kp F9     &kp PSCRN    &trans  &trans  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &trans        &trans  &trans
&trans  &kp F11  &kp F4  &kp F5     &kp F6     &kp SLCK     &trans  &trans  &trans      &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &trans  &trans
&trans  &kp F10  &kp F1  &kp F2     &kp F3     &kp C_PAUSE                  &trans      &trans        &trans        &trans        &trans  &trans
                         &kp K_APP  &kp SPACE  &kp TAB                      &trans      &trans        &trans
            >;
        };
    };
};
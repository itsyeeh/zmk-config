#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    behaviors {
        HML: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_L";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced"; // <--- This is the magic ingredient
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <7 8 12 13 21 22 23 24 25 26 27 34 35 36 37 38 39 43 9 10 11 44 45>;
            hold-trigger-on-release;
        };

        HMR: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 40 41 42>;
            hold-trigger-on-release;
        };

        HMShifL: HMShifL {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSHIFL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 34 35 36 37 38 39 43 44 45>;
        };

        HMShiftR: HMShiftR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSHIFTR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 40 41 42>;
        };
    };

    combos {
        compatible = "zmk,combos";

        exclCombo {
            bindings = <&kp EXCL>;
            key-positions = <15 1>;
            layers = <0>;
        };

        AtCombo {
            bindings = <&kp AT>;
            key-positions = <16 2>;
            layers = <0>;
        };

        HashCombo {
            bindings = <&kp HASH>;
            key-positions = <17 3>;
            layers = <0>;
        };

        DollCombo {
            bindings = <&kp DOLLAR>;
            key-positions = <18 4>;
            layers = <0>;
        };

        PercCombo {
            bindings = <&kp PERCENT>;
            key-positions = <19 5>;
            layers = <0>;
        };

        CaretCombo {
            bindings = <&kp CARET>;
            key-positions = <22 8>;
            layers = <0>;
        };

        AmpsCombo {
            bindings = <&kp AMPERSAND>;
            key-positions = <23 9>;
            layers = <0>;
        };

        AsterCombo {
            bindings = <&kp ASTRK>;
            key-positions = <24 10>;
            layers = <0>;
        };

        LpareCombo {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <25 11>;
            layers = <0>;
        };

        RpareCombo {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <26 12>;
            layers = <0>;
        };

        RbrceCombo {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <38 26>;
            layers = <0>;
        };

        LbrceCom {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <37 25>;
            layers = <0>;
        };

        RbracCom {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <36 24>;
            layers = <0>;
        };

        LbracCom {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <35 23>;
            layers = <0>;
        };

        PipeCom {
            bindings = <&kp PIPE>;
            key-positions = <34 22>;
            layers = <0>;
        };

        BslhCom {
            bindings = <&kp BACKSLASH>;
            key-positions = <33 19>;
            layers = <0>;
        };

        PlusCom {
            bindings = <&kp PLUS>;
            key-positions = <32 18>;
            layers = <0>;
        };

        EqualCom {
            bindings = <&kp EQUAL>;
            key-positions = <31 17>;
            layers = <0>;
        };

        UnderCom {
            bindings = <&kp UNDER>;
            key-positions = <30 16>;
            layers = <0>;
        };

        MinusCom {
            bindings = <&kp MINUS>;
            key-positions = <29 15>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // LAYER 0: BASE (COLEMAK-DH)
        /*
               Pinky      Ring     Middle    Index     Inner             Inner      Index     Middle    Ring     Pinky
            ┌─────────┬─────────┬─────────┬─────────┬─────────┐       ┌─────────┬─────────┬─────────┬─────────┬─────────┐
        Top |    Q    |    W    |    F    |    P    |    B    |       |    J    |    L    |    U    |    Y    |    '    |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├─────────┼─────────┼─────────┼─────────┼─────────┤
        Home|    A    |    R    |    S    |    T    |    G    |       |    M    |    N    |    E    |    I    |    O    |
            |  (LALT) | (LCTRL) |  (LGUI) | (LSHFT) |         |       |         | (RSHFT) |  (RGUI) | (RCTRL) |  (RALT) |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├─────────┼─────────┼─────────┼─────────┼─────────┤
        Bot |    Z    |    X    |    C    |    D    |    V    |       |    K    |    H    |    ,    |    .    |    /    |
            └─────────┴─────────┴─────────┴─────────┴─────────┘       └─────────┴─────────┴─────────┴─────────┴─────────┘
                        (X)    ┌─────────┬─────────┬─────────┐       ┌─────────┬─────────┬─────────┐   (X)
                                |   ESC   |  SPACE  |   TAB   |       |   RET   |   BSPC  |   DEL   |
                                | (MEDIA) |  (NAV)  | (MOUSE) |       |  (SYM)  |  (NUM)  |  (FUN)  |
                                └─────────┴─────────┴─────────┘       └─────────┴─────────┴─────────┘
        */

        default_layout {
            display-name = "BASE";
            bindings = <
&kp TAB         &kp Q        &kp W         &kp E         &kp R         &kp T  &trans  &trans  &kp Y              &kp U         &kp I          &kp O         &kp P           &kp GRAVE
&kp ESCAPE      &HML LALT A  &HML LCTRL S  &HML LGUI D   &HML LSHFT F  &kp G  &trans  &trans  &kp H              &HMR RSHFT J  &HMR RGUI K    &HMR RCTRL L  &HMR RALT SEMI  &kp APOSTROPHE
&kp LEFT_SHIFT  &kp Z        &kp X         &kp C         &kp V         &kp B                  &kp N              &kp M         &kp COMMA      &kp PERIOD    &lt 3 FSLH      &kp RET
                                           &kp LEFT_GUI  &lt 1 SPACE   &mo 2                  &kp RIGHT_CONTROL  &mo 2         &kp BACKSPACE
            >;
        };

        // LAYER 1: NAV (Left Thumb Middle)
        /*
            ┌───────────┬────────────┬────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |     X     |      X     |      X     |      X     |      X     |   |    AGAIN   |    PASTE   |    COPY    |     CUT    |    UNDO    |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|     X     |    LALT    |    LCTRL   |    LGUI    |    LSHFT   |   |    CAPS    |    LEFT    |    DOWN    |     UP     |    RIGHT   |
            |           |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |   |            |            |            |            |            |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |     X     |      X     |      X     |      X     |      X     |   |     INS    |    HOME    |    PG_DN   |    PG_UP   |     END    |
            └───────────┴────────────┴────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┴────────────┴────────────┘
                                    ┌────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┐
                                    |      X     |   (HOLD)   |      X     |   |     RET    |    BSPC    |     DEL    |
                                    |            |     NAV    |            |   |            |            |            |
                                    └────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┘
        */

        nav_layer {
            display-name = "NAV";
            bindings = <
&trans  &kp PLUS  &kp MINUS  &kp STAR  &kp FSLH  &kp DOT  &trans  &trans  &mkp LCLK     &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp RCLK
&trans  &kp N1    &kp N2     &kp N3    &kp N4    &kp N5   &trans  &trans  &kp RC(LEFT)  &kp LEFT         &kp DOWN        &kp UP        &kp RIGHT        &kp RC(RIGHT)
&trans  &kp N6    &kp N7     &kp N8    &kp N9    &kp N0                   &kp RG(UP)    &kp HOME         &kp PG_DN       &kp PG_UP     &kp END          &kp RG(DOWN)
                             &trans    &trans    &trans                   &kp RET       &kp RC(RS(TAB))  &kp RC(TAB)
            >;
        };

        // LAYER 2: MOUSE (Left Thumb Inner) - Placeholder for Mouse Keys
        /*
            ┌───────────┬────────────┬────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |     X     |      X     |      X     |      X     |      X     |   |    AGAIN   |    PASTE   |    COPY    |     CUT    |    UNDO    |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|     X     |    LALT    |    LCTRL   |    LGUI    |    LSHFT   |   |      -     |   MS LEFT  |   MS DOWN  |    MS UP   |  MS RIGHT  |
            |           |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |   |            |            |            |            |            |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |     X     |      X     |      X     |      X     |      X     |   |      -     |   SCRL LF  |   SCRL DN  |   SCRL UP  |   SCRL RT  |
            └───────────┴────────────┴────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┴────────────┴────────────┘
                                    ┌────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┐
                                    |      X     |      X     |   (HOLD)   |   |   R-CLICK  |   L-CLICK  |   M-CLICK  |
                                    |            |            |   MOUSE    |   |            |            |            |
                                    └────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┘
        */
        // LAYER 3: SYM (Right Thumb Inner)
        /*
            ┌─────────┬─────────┬─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |    {    |    &    |    *    |    (    |    }    |       |      X     |      X     |      X     |      X     |      X     |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|    :    |    $    |    %    |    ^    |    +    |       |      X     |    RSHFT   |    RGUI    |    RCTRL   |    RALT    |
            |         |         |         |         |         |       |            |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |    ~    |    !    |    @    |    #    |    |    |       |      X     |      X     |      X     |      X     |      X     |
            └─────────┴─────────┴─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┴────────────┴────────────┘
                                ┌─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┐
                                |    (    |    )    |    _    |       |   (HOLD)   |      X     |      X     |
                                |         |         |         |       |     SYM    |            |            |
                                └─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┘
        */
        // LAYER 4: MEDIA (Left Thumb Outer)
        /*
            ┌───────────┬────────────┬────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |     X     |      X     |      X     |      X     |      X     |   |      X     |     BT 1   |     BT 2   |     BT 3   |      X     |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|     X     |    LALT    |    LCTRL   |    LGUI    |    LSHFT   |   |      X     |    PREV    |   VOL DN   |   VOL UP   |    NEXT    |
            |           |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |   |            |            |            |            |            |
            ├───────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |     X     |      X     |      X     |      X     |      X     |   |    BT CLR  |   SYS RST  |   BOOTLDR  |      X     |   STUDIO   |
            └───────────┴────────────┴────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┴────────────┴────────────┘
                                    ┌────────────┬────────────┬────────────┐   ┌────────────┬────────────┬────────────┐
                                    |   (HOLD)   |      X     |      X     |   |    STOP    |    PLAY    |    MUTE    |
                                    |    MEDIA   |            |            |   |            |            |            |
                                    └────────────┴────────────┴────────────┘   └────────────┴────────────┴────────────┘
        */
        // LAYER 5: NUM (Right Thumb Middle)
        /*
            ┌─────────┬─────────┬─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |    [    |    7    |    8    |    9    |    ]    |       |      X     |      X     |      X     |      X     |      X     |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|    ;    |    4    |    5    |    6    |    =    |       |      X     |    RSHFT   |    RGUI    |    RCTRL   |    RALT    |
            |         |         |         |         |         |       |            |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |    `    |    1    |    2    |    3    |    \    |       |      X     |      X     |      X     |      X     |      X     |
            └─────────┴─────────┴─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┴────────────┴────────────┘
                                ┌─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┐
                                |    .    |    0    |    -    |       |      X     |   (HOLD)   |      X     |
                                |         |         |         |       |            |     NUM    |            |
                                └─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┘
        */

        sym_layer {
            display-name = "SYM";
            bindings = <
&trans  &kp EXCLAMATION  &kp AT  &kp HASH   &kp DOLLAR  &kp PERCENT  &trans  &trans  &kp CARET  &kp AMPS   &kp STAR       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp N1           &kp N2  &kp N3     &kp N4      &kp N5       &trans  &trans  &kp UNDER  &kp PLUS   &kp PIPE       &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans
&trans  &kp N6           &kp N7  &kp N8     &kp N9      &kp N0                       &kp MINUS  &kp EQUAL  &kp BACKSLASH  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans
                                 &kp COMMA  &kp DOT     &kp SPACE                    &trans     &trans     &trans
            >;
        };

        // LAYER 6: FUN (Right Thumb Outer)
        /*
            ┌─────────┬─────────┬─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┬────────────┬────────────┐
        Top |  PSCRN  |    F9   |    F8   |    F7   |   F12   |       |      X     |      X     |      X     |      X     |      X     |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Home|  SLCK   |    F6   |    F5   |    F4   |   F11   |       |      X     |    RSHFT   |    RGUI    |    RCTRL   |    RALT    |
            |         |         |         |         |         |       |            |  (Sticky)  |  (Sticky)  |  (Sticky)  |  (Sticky)  |
            ├─────────┼─────────┼─────────┼─────────┼─────────┤       ├────────────┼────────────┼────────────┼────────────┼────────────┤
        Bot |  PAUSE  |    F3   |    F2   |    F1   |   F10   |       |      X     |      X     |      X     |      X     |      X     |
            └─────────┴─────────┴─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┴────────────┴────────────┘
                                ┌─────────┬─────────┬─────────┐       ┌────────────┬────────────┬────────────┐
                                |   APP   |  SPACE  |   TAB   |       |      X     |      X     |   (HOLD)   |
                                |         |         |         |       |            |            |     FUN    |
                                └─────────┴─────────┴─────────┘       └────────────┴────────────┴────────────┘
        */

        fun_layer {
            display-name = "FN";
            bindings = <
&trans  &trans  &trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans      &trans        &trans         &trans    &kp UP
&trans  &kp F1  &kp F2  &kp F3   &kp F4   &kp F5   &trans  &trans  &trans  &kp K_MUTE  &kp C_VOL_DN  &kp C_VOL_UP   &kp LEFT  &kp RIGHT
&trans  &kp F6  &kp F7  &kp F8   &kp F9   &kp F10                  &trans  &trans      &kp RC(LEFT)  &kp RC(RIGHT)  &trans    &kp DOWN
                        &kp F11  &kp F12  &trans                   &trans  &trans      &trans
            >;
        };
    };
};
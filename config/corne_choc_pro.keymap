#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    combos {
        compatible = "zmk,combos";
        
        combo_esc {
            timeout-ms = <50>;
            key-positions = <23 24>; // The positions of J and K on a 42-key Corne
            bindings = <&kp ESC>;
        };
    };
};

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            // ---------------------------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E   |  R      |  T      |   |   |  Y       |  U       |  I   |  O  |  P  | BSPC   |
            // | CTRL |  A  |  S  |  D   |  F      |  G      |   |   |  H       |  J       |  K   |  L  |  ;  |  '     |
            // | SHFT |  Z  |  X  |  C   |  V      |  B      |       |  N       |  M       |  ,   |  .  |  /  | FN/ESC |
            //                    | GRAVE/SHFT | GUI/SPC | NAV/TAB |       | SYM/BSPC | ALT/RET  | SQT/SHFT |
            bindings = <
                &kp TAB   &kp Q   &kp W &kp E            &kp R           &kp T     &trans &trans  &kp Y      &kp U        &kp I     &kp O   &kp P    &kp BSPC
                &kp LCTRL &kp A   &kp S &kp D            &kp F           &kp G     &trans &trans  &kp H      &kp J        &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &lt 3 Z &kp X &kp C            &kp V           &kp B                    &kp N      &kp M        &kp COMMA &kp DOT &kp FSLH &lt 3 ESC
                                        &mt LSHFT GRAVE  &mt LGUI SPACE  &lt 2 TAB                &lt 1 BSPC &mt ALT RET  &mt RSHFT SQT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        raise_layer {
            display-name = "SYM";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #   |  $      |  %  |   |   |  ^  |  &  |  *   |  (  |  )  | BSPC |
            // | CTRL |  1  |  2  |  3   |  4      |  5  |   |   |  -  |  =  |  \   |  [  |  ]  |  `   |
            // | SHFT |  6  |  7  |  8   |  9      |  0  |       |  _  |  +  | "|"  |  {  |  }  |  ~   |
            //                    | SHFT | GUI/SPC |     |       |     |     | SHFT |
            bindings = <
                &kp  TAB  &kp EXCL &kp AT &kp HASH  &kp DLLR       &kp PRCNT &trans &trans &kp CARET &kp AMPS    &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL &kp N1   &kp N2 &kp N3    &kp N4         &kp N5    &trans &trans &kp MINUS &kp EQUAL   &kp BSLH  &kp LBKT &kp RBKT &kp GRAVE
                &kp LSHFT &kp N6   &kp N7 &kp N8    &kp N9         &kp N0                  &kp UNDER &kp PLUS    &kp PIPE  &kp LBRC &kp RBRC &kp TILDE
                                          &kp LSHFT &mt LGUI SPACE &kp TAB                 &trans    &mt ALT RET &kp RSHFT
            >;
        };

        lower_layer {
            display-name = "NAV";
            // ---------------------------------------------------------------------------------------------------
            // |  TAB |     |     |      |        |       |   |   |        |         |      |       |     | BSPC |
            // | CTRL |     |     |      |        |       |   |   | LFT    | DWN     |  UP  | RGT   |     |      |
            // | SHFT |     |     |      |        |       |       | PG_UP  | HOME    | END  | PG_DN |     |      |
            //                    | SHFT |GUI/SPC |       |       | BSPC   | ALT/RET | SHFT |
            bindings = <
                &kp TAB   &trans  &trans &trans    &trans         &trans  &trans &trans  &trans     &trans       &trans    &trans     &trans &kp BSPC
                &kp LCTRL &trans  &trans &trans    &trans         &trans  &trans &trans  &kp LEFT   &kp DOWN     &kp UP    &kp RIGHT  &trans &trans
                &kp LSHFT &trans  &trans &trans    &trans         &trans                 &kp PG_UP  &kp HOME     &kp END   &kp PG_DN  &trans &trans
                                         &kp LSHFT &mt LGUI SPACE &trans                 &kp BSPC   &mt ALT RET  &kp RSHFT
            >;
        };

        fn_layer {
            display-name = "FN";
            // ------------------------------------------------------------------------------------------------
            // |      | F1   | F2   | F3  | F4   | F5     |   |   | F6  | F7   | F8       | F9       | F10 |   |
            // |      | BT1  | BT2  | BT3 |      |        |   |   |     |      |          |          | F11 |   |
            // |      |      | BTCR | RST | BOOT | Unlock |       |     | MUTE | C_VOL_DN | C_VOL_UP | F12 |   |
            //                      |     |      |        |       |     |      |          |
            bindings = <
                &trans &kp F1       &kp F2       &kp F3       &kp F4       &kp F5         &trans &trans  &kp F6 &kp F7     &kp F8       &kp F9        &kp F10 &trans
                &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans       &trans         &trans &trans  &trans &trans     &trans       &trans        &kp F11 &trans
                &trans &trans       &bt BT_CLR   &sys_reset   &bootloader  &studio_unlock                &trans &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP  &kp F12 &trans
                                                 &trans       &trans       &trans                        &trans &trans     &trans
            >;
        };
    };
};


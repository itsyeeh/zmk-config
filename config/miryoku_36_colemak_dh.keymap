/*
 * Miryoku Colemak-DH — 36-key (3x5 + 3 per half) ZMK keymap
 * Based on the Miryoku reference (manna-harbour/miryoku docs/reference)
 *
 * Layers included (reference grouping / hand responsibilities):
 * 0 = BASE   (Colemak-DH)
 * 1 = NAV    (right-hand primary, accessed by holding left home-thumb)
 * 2 = MOUSE  (right-hand secondary)
 * 3 = MDIA   (right-hand tertiary / media)
 * 4 = NUM    (left-hand primary, accessed by holding right home-thumb)
 * 5 = SYM    (left-hand secondary)
 * 6 = FUN    (left-hand tertiary / F-keys)
 * 7 = BUTTON (button/pointing-device helpers — optional extra)
 *
 * Thumb cluster (per-hand, from outer → inner):
 *  L-outer: transparent
 *  L-mid:   LT(1, TAB)         - hold -> NAV (right-hand layers), tap -> TAB
 *  L-inner: MT(LSHFT, SPACE)  - hold -> LSHIFT, tap -> SPACE
 *  R-inner: MT(LGUI, BSPC)    - hold -> LGUI, tap -> BSPC
 *  R-mid:   LT(4, RET)        - hold -> NUM (left-hand layers), tap -> RET
 *  R-outer: transparent
 *
 * Notes:
 * - This file aims to follow the Miryoku reference layout semantics:
 *   - Right-hand layers (NAV / MOUSE / MDIA / BUTTON) are activated by holding a left-thumb LT.
 *   - Left-hand layers (NUM / SYM / FUN) are activated by holding a right-thumb LT.
 * - Each layer has a text "map" comment above its bindings, reflecting the Miryoku reference intention.
 * - This keymap uses Colemak Mod-DH alphas on BASE and on mirrored Extra/Tap variants where applicable.
 *
 * Adjust layer indices or thumb behaviors if you want different thumb-to-layer assignments.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * Layer indices:
         * 0 BASE (Colemak-DH)
         * 1 NAV  (right-hand primary)
         * 2 MOUSE (right-hand secondary)
         * 3 MDIA  (right-hand tertiary / media)
         * 4 NUM  (left-hand primary)
         * 5 SYM  (left-hand secondary)
         * 6 FUN  (left-hand tertiary / F-keys)
         * 7 BUTTON (mouse buttons / clipboard helpers)
         */

        /*
         * BASE (Miryoku Colemak-DH)
         *
         * Reference mapping (per half, pinky → pinky):
         * Top:    Q  W  F  P  B    |   J  L  U  Y  '
         * Home:   A  R  S  T  G    |   M  N  E  I  O
         * Bot:    Z  X  C  D  V    |   K  H  ,  .  /
         * Thumbs: (trans)  LT(NAV,TAB)  MT(LSHFT,SPACE)   MT(LGUI,BSPC)  LT(NUM,RET)  (trans)
         *
         * Note: Apostrophe replaces semicolon per Miryoku reference; comma/dot/slash on bottom row.
         */
        default_layer {
            display-name = "BASE (Miryoku Colemak-DH)";

            bindings = <
                /* Row 1 (top) */
                &kp Q   &kp W   &kp F   &kp P   &kp B            &kp J   &kp L   &kp U   &kp Y   &kp APOSTR
                /* Row 2 (home) */
                &kp A   &kp R   &kp S   &kp T   &kp G            &kp M   &kp N   &kp E   &kp I   &kp O
                /* Row 3 (bottom) */
                &kp Z   &kp X   &kp C   &kp D   &kp V            &kp K   &kp H   &kp COMMA &kp DOT &kp FSLH
                /* Thumb cluster (6) */
                &trans  &lt 1 TAB &mt LSHFT SPACE   &mt LGUI BSPC  &lt 4 RET  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        /*
         * NAV (right-hand primary, activated by holding left home-thumb)
         *
         * Reference intent (right-hand = navigation/editing):
         * Left half (general): clipboard keys / modifiers / page-line controls
         * Right half (home row): Left / Down / Up / Right / Backspace (cursor cluster on home)
         * Row below: line/page up/down, etc.
         *
         * Visual (approximate):
         * Top:    TAB  -    -    -   VOL+   | PGUP  HOME  UP   END  DEL
         * Home:   LALT LCTRL LGUI LSHFT VOL- | PGDN  LEFT DOWN RIGHT BSPC
         * Bot:    ESC  -    -    -   MUTE    | BTN2  TABL TABR  -   RET
         */
        nav_layer {
            display-name = "NAV";

            bindings = <
                /* Row 1 */
                &kp TAB   &trans      &trans      &trans     &kp C_VOL_UP   &kp PG_UP   &kp HOME   &kp UP     &kp END    &kp DEL
                /* Row 2 */
                &kp LALT  &kp LCTRL   &kp LGUI    &kp LSHFT  &kp C_VOL_DN   &kp PG_DN   &kp LEFT   &kp DOWN   &kp RIGHT  &kp BSPC
                /* Row 3 */
                &kp ESC   &trans      &trans      &trans     &kp C_MUTE                   &trans     &trans     &trans     &trans     &kp RET
                /* Thumbs */
                &trans   &lt 1 TAB &mt LSHFT SPACE  &mt LGUI BSPC &lt 4 RET &trans
            >;
        };

        /*
         * MOUSE (right-hand secondary)
         *
         * Reference intent:
         * - Mirror NAV on home row but with mouse motion, wheel on below row.
         * - Mouse buttons on thumbs (but here we keep buttons mapped to ms_btn1/2 on right half).
         *
         * Visual (approximate):
         * Top:    -   -   -   -   -     | BTN1 BTN2  -   -   -
         * Home:   -   -   -   -   -     | ACCEL UP LEFT DOWN RIGHT
         * Bot:    -   -   -   -   -     | MOVE HORIZ VERT  -   -
         */
        mouse_layer {
            display-name = "MOUSE";

            bindings = <
                /* Row 1 */
                &trans  &trans  &trans  &trans  &trans   &ms_btn1  &ms_btn2  &trans  &trans  &trans
                /* Row 2 */
                &trans  &trans  &trans  &trans  &trans   &ms_accel &ms_up    &ms_left &ms_down &ms_right
                /* Row 3 */
                &trans  &trans  &trans  &trans  &trans   &ms_move  &ms_horiz &ms_vert &trans &trans
                /* Thumbs */
                &trans   &lt 1 TAB &mt LSHFT SPACE  &mt LGUI BSPC &lt 4 RET &trans
            >;
        };

        /*
         * MDIA (right-hand tertiary / media)
         *
         * Reference intent:
         * - Media controls (Prev / Play / Next / Volume) and some RGB controls on top row.
         *
         * Visual (approximate):
         * Top:   MUTE  VOL-  VOL+  PREV  NEXT   | PLAY  STOP  REC  RGB-  RGB+
         * Home:  SEL   EJECT  -     -     -      |  -     -     -    -     -
         * Bot:   -     -      -     -     -      |  -     -     -    -     -
         */
        mdia_layer {
            display-name = "MDIA";

            bindings = <
                /* Row 1 */
                &kp MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PREV  &kp C_NEXT  &kp MEDIA_PLAY  &kp MEDIA_STOP &kp MEDIA_REC &trans &trans
                /* Row 2 */
                &trans  &kp MEDIA_SEL  &kp MEDIA_EJECT &trans &trans &trans &trans &trans &trans &trans
                /* Row 3 */
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                /* Thumbs */
                &trans   &lt 1 TAB &mt LSHFT SPACE  &mt LGUI BSPC &lt 4 RET &trans
            >;
        };

        /*
         * NUM (left-hand primary, activated by holding right home-thumb)
         *
         * Reference intent:
         * - Numpad-style numerals and commonly used math symbols on left-hand.
         * - Right hand retains navigation/edit duplication for mixed use.
         *
         * Visual (approximate left-hand focus):
         * Top L:  7  8  9  /  %    |  (right side keeps useful keys)
         * Home L: 4  5  6  *  =
         * Bot L:  1  2  3  -  0
         * Thumbs: same thumbs as BASE (LTs/MTs)
         */
        num_layer {
            display-name = "NUM";

            bindings = <
                /* Row 1 */
                &kp N7   &kp N8   &kp N9   &kp PDIV  &kp PENT        &trans &trans &trans &trans &trans
                /* Row 2 */
                &kp N4   &kp N5   &kp N6   &kp PAST  &kp PPLS        &trans &trans &trans &trans &trans
                /* Row 3 */
                &kp N1   &kp N2   &kp N3   &kp PMNS  &kp N0          &trans &trans &trans &trans &trans
                /* Thumbs */
                &trans   &lt 1 TAB &mt LSHFT SPACE  &mt LGUI BSPC &lt 4 RET &trans
            >;
        };

        /*
         * SYM (left-hand secondary)
         *
         * Reference intent:
         * - Shifted symbols co-located with NUM positions to reduce chording.
         *
         * Visual (approximate):
         * Top L:  !  @  #  $  %
         * Home L: ( )  _  +  |
         * Bot L:  ^  &  *  (  )
         */
        sym_layer {
            display-name = "SYM";

            bindings = <
                /* Row 1 */
                &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT     &trans &trans &trans &trans &trans
                /* Row 2 */
                &kp LEFT_BRACKET /* placeholder */ &kp RIGHT_BRACKET /* placeholder */ &trans &trans &trans &trans &trans &trans &trans &trans
                /* Row 3 */
                &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR   &trans &trans &trans &trans &trans
                /* Thumbs */
                &trans   &lt 1 TAB &mt LSHFT SPACE  &mt LGUI BSPC &lt 4 RET &trans
            >;
        };

        /*
         * FUN (left-hand tertiary)
         *
         * Reference intent:
         * - Function keys mirrored to NUM positions; system controls on inner column.
         *
         * Visual (approximate):
         * Top L:  F7 F8 F9 F10 F11
         * Home L: F4 F5 F6 F1 F2
         * Bot L:  F1 F2 F3  RST  BLDR
         */
        fun_layer {
            display-name = "FUN";

            bindings = <
                /* Row 1 */
                &trans &kp F7  &kp F8  &kp F9  &kp F10  &trans &trans &trans &trans &trans
                /* Row 2 */
                &trans &kp F4  &kp F5  &kp F6  &kp F11  &trans &trans &trans &trans &trans
                /* Row 3 */
                &trans &kp F1  &kp F2  &kp F3  &sys_reset &bootloader &trans &trans &trans &trans
                /* Thumbs */
                &trans   &lt 1 TAB &mt LSHFT SPACE  &mt LGUI BSPC &lt 4 RET &trans
            >;
        };

        /*
         * BUTTON (helper layer)
         *
         * Reference intent:
         * - Provides extra pointing-device buttons and clipboard helpers for either-hand use.
         * - Useful for integrated pointing devices or external devices.
         */
        button_layer {
            display-name = "BUTTON";

            bindings = <
                /* Row 1 */
                &trans &trans &trans &trans &trans  &ms_btn1 &ms_btn2 &ms_btn3 &trans &trans
                /* Row 2 */
                &trans &trans &trans &trans &trans  &kp CUT  &kp COPY &kp PASTE &trans &trans
                /* Row 3 */
                &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans
                /* Thumbs */
                &trans   &lt 1 TAB &mt LSHFT SPACE  &mt LGUI BSPC &lt 4 RET &trans
            >;
        };
    };
};

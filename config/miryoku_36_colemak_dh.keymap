#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,physical-layout = &base_layer;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        // LAYER 0: BASE (COLEMAK-DH)
        base_layer {
            bindings = <
                &trans  &kp Q      &kp W      &kp F       &kp P       &kp B      &trans        &trans  &kp J       &kp L       &kp U       &kp Y       &kp SEMI   &trans
                &trans  &hm LGUI A &hm LALT R &hm LCTRL S &hm LSHFT T &kp G      &trans        &trans  &kp M       &hm RSHFT N &hm RCTRL E &hm RALT I  &hm RGUI O &trans
                &trans  &kp Z      &kp X      &kp C       &kp D       &kp V                            &kp K       &kp H       &kp COMMA   &kp DOT     &kp FSLH   &trans
                                              &lt 4 TAB   &lt 1 SPACE &lt 2 ESC                        &lt 3 RET   &lt 5 BSPC  &lt 6 DEL
            >;
        };

        // LAYER 1: NAV (Left Thumb Middle)
        nav_layer {
            bindings = <
                &trans  &trans     &trans     &trans      &trans      &trans     &trans        &trans  &kp AGAIN   &kp PASTE   &kp COPY    &kp CUT     &kp UNDO   &trans
                &trans  &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT   &trans     &trans        &trans  &kp CAPS    &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT  &trans
                &trans  &trans     &trans     &trans      &trans      &trans                           &kp INS     &kp HOME    &kp PG_DN   &kp PG_UP   &kp END    &trans
                                              &trans      &trans      &trans                           &kp RET     &kp BSPC    &kp DEL
            >;
        };

        // LAYER 2: MOUSE (Left Thumb Inner) - Placeholder for Mouse Keys
        mouse_layer {
            bindings = <
                &trans  &trans     &trans     &trans      &trans      &trans     &trans        &trans  &trans      &trans      &trans      &trans      &trans     &trans
                &trans  &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT   &trans     &trans        &trans  &trans      &trans      &trans      &trans      &trans     &trans
                &trans  &trans     &trans     &trans      &trans      &trans                           &trans      &trans      &trans      &trans      &trans     &trans
                                              &trans      &trans      &trans                           &trans      &trans      &trans
            >;
        };

        // LAYER 3: SYM (Right Thumb Inner)
        sym_layer {
            bindings = <
                &trans  &kp LBRC   &kp AMPS   &kp ASTRK   &kp LPAR    &kp RBRC   &trans        &trans  &trans      &trans      &trans      &trans      &trans     &trans
                &trans  &kp COLON  &kp DLLR   &kp PRCNT   &kp CARET   &kp PLUS   &trans        &trans  &trans      &kp RSHFT   &kp RCTRL   &kp RALT    &kp RGUI   &trans
                &trans  &kp TILDE  &kp EXCL   &kp AT      &kp HASH    &kp PIPE                         &trans      &trans      &trans      &trans      &trans     &trans
                                              &kp LPAR    &kp RPAR    &kp UNDER                        &trans      &trans      &trans
            >;
        };

        // LAYER 4: MEDIA (Left Thumb Outer)
        media_layer {
            bindings = <
                &trans  &trans     &trans     &trans      &trans      &trans     &trans        &trans  &trans      &trans      &trans      &trans      &trans     &trans
                &trans  &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT   &trans     &trans        &trans  &trans      &kp C_PREV  &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &trans
                &trans  &trans     &trans     &trans      &trans      &trans                           &trans      &bt BT_PRV  &bt BT_NXT  &trans      &bt BT_CLR &trans
                                              &trans      &trans      &trans                           &kp C_STOP  &kp C_PP    &kp C_MUTE
            >;
        };

        // LAYER 5: NUM (Right Thumb Middle)
        num_layer {
            bindings = <
                &trans  &kp LBKT   &kp N7     &kp N8      &kp N9      &kp RBKT   &trans        &trans  &trans      &trans      &trans      &trans      &trans     &trans
                &trans  &kp SEMI   &kp N4     &kp N5      &kp N6      &kp EQUAL  &trans        &trans  &trans      &kp RSHFT   &kp RCTRL   &kp RALT    &kp RGUI   &trans
                &trans  &kp GRAVE  &kp N1     &kp N2      &kp N3      &kp BSLH                         &trans      &trans      &trans      &trans      &trans     &trans
                                              &kp DOT     &kp N0      &kp MINUS                        &trans      &trans      &trans
            >;
        };

        // LAYER 6: FUN (Right Thumb Outer)
        fun_layer {
            bindings = <
                &trans  &kp F12    &kp F7     &kp F8      &kp F9      &kp PSCRN  &trans        &trans  &trans      &trans      &trans      &trans      &trans     &trans
                &trans  &kp F11    &kp F4     &kp F5      &kp F6      &kp SLCK   &trans        &trans  &trans      &kp RSHFT   &kp RCTRL   &kp RALT    &kp RGUI   &trans
                &trans  &kp F10    &kp F1     &kp F2      &kp F3      &kp PAUSE                        &trans      &trans      &trans      &trans      &trans     &trans
                                              &kp K_APP   &kp SPACE   &kp TAB                          &trans      &trans      &trans
            >;
        };
    };
};